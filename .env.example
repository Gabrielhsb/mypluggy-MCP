# Credenciais da sua aplicação no dashboard do Pluggy (https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# IDs dos itens conectados (um por banco), separados por vírgula.
# Veja no Dashboard: Applications → sua aplicação → Connected Items.
PLUGGY_ITEM_IDS=

# URL pública do servidor, sem barra no final. O endpoint MCP será PUBLIC_URL/mcp.
# Em desenvolvimento local: http://localhost:3000
PUBLIC_URL=https://mcp.example.com

# Token usado UMA vez para cadastrar sua passkey no primeiro acesso.
# Gere com: openssl rand -base64 32
SETUP_TOKEN=

# Domínio usado pelo Caddy (só se subir com --profile caddy). Igual ao host do PUBLIC_URL.
MCP_DOMAIN=mcp.example.com

# Opcionais
# PORT=3000
# DATA_DIR=./data
# MCP_HOST_PORT=3000   # porta do host em que o container fica exposto (127.0.0.1)
