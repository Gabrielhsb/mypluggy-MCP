# Para servidores que já usam nginx nas portas 80/443 (sem o Caddy do compose).
# 1. Troque mcp.example.com pelo seu domínio e copie para /etc/nginx/sites-available/mypluggy-mcp
# 2. sudo ln -s /etc/nginx/sites-available/mypluggy-mcp /etc/nginx/sites-enabled/
# 3. sudo nginx -t && sudo systemctl reload nginx
# 4. sudo certbot --nginx -d mcp.example.com   (gera o HTTPS e ajusta este arquivo)
server {
    listen 80;
    server_name mcp.example.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
