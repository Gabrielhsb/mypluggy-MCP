{
  "name": "mypluggy-mcp",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "doctor": "tsx --env-file=.env src/doctor.ts",
    "lint": "eslint . && tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "mcp",
    "pluggy",
    "open-finance",
    "claude",
    "model-context-protocol"
  ],
  "license": "MIT",
  "description": "Servidor MCP remoto (somente leitura) que expõe seus dados do Open Finance via Pluggy para o Claude",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pluggy-sdk": "^0.93.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabrielhsb/mypluggy-MCP.git"
  }
}
